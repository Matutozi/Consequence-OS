#!/usr/bin/env bash
# The ConsequenceOS plugin's hook: a policy on every tool call Claude Code
# makes, decided by consequenced -hook claude-code.
#
#   consequenceos setup     at the start of a session: start installing
#                           consequenced in the background if it isn't
#                           there, and say what's happening
#   consequenceos hook      before each tool call: the policy decides it
#   consequenceos install   download and install consequenced, then write
#                           the starter policy; setup and hook run this in
#                           the background, and it can be run by hand
#   consequenceos check     print the policy's rules and warnings, and run
#                           its tests (/consequenceos:check)
#   consequenceos try       check rules given on stdin, in the "Your rules"
#                           section of a copy of the policy; the policy
#                           itself isn't changed (/consequenceos:add-rule)
#
# consequenced is the release VERSION names, downloaded once into the
# plugin's data folder. The download must match SHA256SUMS beside this
# script, which ships inside the plugin, so a release file swapped after
# the plugin was published never runs. CONSEQUENCEOS_BIN runs another
# consequenced instead, such as one built from source.
#
# The download runs in the background, so starting a session never waits
# for it and a tool call never times out on it. Until it's done, each tool
# call is blocked straight away, with a message saying why. That is the
# plugin failing closed: if consequenced can't decide a call, it doesn't run.
set -uo pipefail

VERSION=v0.7.0
REPO=https://github.com/Matutozi/Consequence-OS

mode="${1:-hook}"
self="${BASH_SOURCE[0]}"
root="$(cd "$(dirname "$self")/.." && pwd)"
data="${CLAUDE_PLUGIN_DATA:-}"
if [ -z "$data" ]; then
  # Claude Code names the plugin's data folder only to its hooks. Run any
  # other way (a slash command's shell, or by hand), the folder is found
  # from where the plugin is installed: <config>/plugins/cache/<marketplace>/
  # <plugin>/<version> keeps its data in <config>/plugins/data/<plugin>-<marketplace>.
  case "$root" in
    */plugins/cache/*/*/*)
      plugin_dir="$(dirname "$root")"
      data="${root%/plugins/cache/*}/plugins/data/$(basename "$plugin_dir")-$(basename "$(dirname "$plugin_dir")")"
      ;;
    *) data="$HOME/.consequence/plugin" ;;
  esac
fi
policy="${CONSEQUENCEOS_POLICY:-$HOME/.consequence/claude-code.yaml}"
lock="$data/.install.lock"   # held by the install that's running; holds its PID
errors="$data/install.error" # why the last install failed
welcome="$data/welcome"      # the note for the person, once the starter policy is written

# json STRING: STRING as a JSON string.
json() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\t'/ }"
  printf '"%s"' "$s"
}

# tell MESSAGE: shows MESSAGE to the person in Claude Code (setup only: a
# hook's stdout is its answer).
tell() { printf '{"systemMessage":%s}\n' "$(json "$1")"; }

fail() {
  case "$mode" in
    hook)
      echo "ConsequenceOS blocked this call: $*" >&2
      exit 2
      ;;
    install)
      printf '%s\n' "$*" >"$errors.tmp" && mv -f "$errors.tmp" "$errors"
      echo "$(date '+%F %T') $*" >&2
      exit 1
      ;;
    check | try)
      echo "ConsequenceOS: $*" >&2
      exit 1
      ;;
    *)
      tell "ConsequenceOS isn't ready, so it blocks Claude's tool calls: $*"
      exit 0
      ;;
  esac
}

sha256() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | cut -d' ' -f1
  else
    shasum -a 256 "$1" | cut -d' ' -f1
  fi
}

# release finds the archive to download for this machine and its checksum:
# the one with consequenced alone where the release has it (v0.7.0 on),
# otherwise the full one. Sets name and want.
release() {
  local os arch
  case "$(uname -s)" in
    Linux) os=linux ;;
    Darwin) os=darwin ;;
    *) fail "consequenced runs on Linux and macOS, not $(uname -s)" ;;
  esac
  case "$(uname -m)" in
    x86_64 | amd64) arch=amd64 ;;
    arm64 | aarch64) arch=arm64 ;;
    *) fail "there's no consequenced build for $(uname -m)" ;;
  esac
  for name in "consequenced_${VERSION}_${os}_${arch}" "consequenceos_${VERSION}_${os}_${arch}"; do
    want="$(awk -v f="$name.tar.gz" '$2 == f { print $1 }' "$root/SHA256SUMS" 2>/dev/null)"
    [ -n "$want" ] && return 0
  done
  fail "this plugin has no checksum for consequenced $VERSION on ${os}_${arch}, so it can't install it. Install consequenced yourself and set CONSEQUENCEOS_BIN to its path"
}

# installing reports whether an install is running. A lock whose process
# is gone, left by an install that was killed, is cleared.
installing() {
  local pid
  [ -d "$lock" ] || return 1
  pid="$(cat "$lock/pid" 2>/dev/null)"
  if [ -n "$pid" ]; then
    kill -0 "$pid" 2>/dev/null && return 0
  elif [ -z "$(find "$lock" -maxdepth 0 -mmin +1 2>/dev/null)" ]; then
    return 0 # just taken; its PID is on the way
  fi
  rm -rf "$lock"
  return 1
}

# background starts consequenceos install on its own, outside Claude
# Code's process group and with its own output, so neither the session nor
# a hook waits for it, and it survives the hook that started it.
background() {
  mkdir -p "$data" || fail "can't create $data"
  if command -v setsid >/dev/null 2>&1; then
    setsid bash "$self" install </dev/null >>"$data/install.log" 2>&1 &
  elif command -v perl >/dev/null 2>&1; then
    perl -MPOSIX -e 'POSIX::setsid(); exec @ARGV' bash "$self" install </dev/null >>"$data/install.log" 2>&1 &
  else
    nohup bash "$self" install </dev/null >>"$data/install.log" 2>&1 &
  fi
}

# progress says how far a download has got.
progress() {
  local part="$data/$name.tar.gz.part" bytes
  [ -f "$part" ] || return 0
  bytes="$(wc -c <"$part" | tr -d ' ')"
  awk -v b="$bytes" 'BEGIN { printf " (%.1f MB downloaded so far)", b / 1048576 }'
}

# write_policy writes the starter policy the first time, and leaves the
# person a note about it. Its output goes to stderr: on stdout, Claude
# Code would read it as the hook's answer.
write_policy() {
  [ -e "$policy" ] && return 0
  "$bin" -init claude-code -policy-only -config "$policy" >&2 ||
    fail "couldn't write the starter policy to $policy"
  printf '%s' "ConsequenceOS is on. It wrote a starter policy to $policy: reads, and edits inside the project, go ahead; other shell commands ask you first; secrets, Claude Code's settings and plugins, and the policy itself are off limits. To change the rules, edit that file. Claude can't." >"$welcome"
}

# take_welcome prints the note about the starter policy, once.
take_welcome() {
  local mine="$welcome.$$"
  [ -f "$welcome" ] && mv "$welcome" "$mine" 2>/dev/null || return 1
  cat "$mine"
  rm -f "$mine"
}

# install downloads consequenced into $bin, checked against the plugin's
# SHA256SUMS, then writes the starter policy. On a slow link a download can
# be cut off, so it resumes: what arrived stays in a .part file, and the
# next install carries on from there.
install() {
  local got tmp="" url protos part
  release
  command -v curl >/dev/null 2>&1 || fail "curl is needed to install consequenced"
  mkdir -p "$data/$VERSION" || fail "can't create $data/$VERSION"
  mkdir "$lock" 2>/dev/null || exit 0 # another install is running
  echo $$ >"$lock/pid"
  trap 'rm -rf "$lock" ${tmp:+"$tmp"}' EXIT
  trap 'exit 143' TERM INT HUP
  rm -f "$errors"

  part="$data/$name.tar.gz.part"
  if [ ! -f "$part" ] || [ "$(sha256 "$part")" != "$want" ]; then
    url="$REPO/releases/download/$VERSION"
    protos='=https'
    if [ -n "${CONSEQUENCEOS_DOWNLOAD_URL:-}" ]; then
      # A mirror, or a local folder for tests. The checksum still has to match.
      url="$CONSEQUENCEOS_DOWNLOAD_URL"
      protos='=https,file'
    fi
    # A download that stalls (under 1 KB/s for a minute) gives up, so the
    # next try can start; it keeps what arrived.
    curl -fsSL --proto "$protos" --tlsv1.2 --retry 2 --speed-limit 1024 --speed-time 60 \
      -C - -o "$part" "$url/$name.tar.gz" ||
      fail "couldn't download consequenced $VERSION from $url; the next try carries on where this one stopped"
  fi
  got="$(sha256 "$part")"
  if [ "$got" != "$want" ]; then
    rm -f "$part"
    fail "the downloaded $name.tar.gz doesn't match the checksum this plugin ships with, so it wasn't installed"
  fi
  tmp="$(mktemp -d "$data/.install.XXXXXX")" || fail "can't create a folder in $data"
  tar -xzf "$part" -C "$tmp" "$name/consequenced" || fail "couldn't unpack consequenced"
  chmod 0755 "$tmp/$name/consequenced" && mv -f "$tmp/$name/consequenced" "$bin" ||
    fail "couldn't install consequenced into $data/$VERSION"
  rm -rf "$tmp" "$part"
  write_policy
  rm -rf "$lock"
  trap - EXIT TERM INT HUP
}

case "$mode" in
  setup | hook | install | check | try) ;;
  *) fail "unknown command $mode: use setup, hook, install, check or try" ;;
esac

if [ -n "${CONSEQUENCEOS_BIN:-}" ]; then
  bin="$CONSEQUENCEOS_BIN"
  [ -x "$bin" ] || fail "CONSEQUENCEOS_BIN is $bin, which isn't a program"
else
  bin="$data/$VERSION/consequenced"
fi

if [ "$mode" = install ]; then
  if [ -x "$bin" ]; then write_policy; else install; fi
  exit 0
fi

if [ "$mode" = check ] || [ "$mode" = try ]; then
  if [ ! -x "$bin" ]; then
    if [ -d "$data/.install.lock" ]; then
      fail "consequenced $VERSION is still downloading in the background; try again in a minute"
    fi
    fail "consequenced $VERSION isn't installed in $data. Start a new Claude Code session so the plugin installs it, or set CONSEQUENCEOS_BIN to a consequenced you installed"
  fi
  [ -e "$policy" ] || fail "there's no policy at $policy yet"
fi

if [ "$mode" = check ]; then
  "$bin" -hook claude-code -check -config "$policy" || exit 1
  tests="${policy%.*}.test.yaml"
  [ -f "$tests" ] || exit 0
  echo
  exec "$bin" -test "$tests"
fi

# try puts the rules on stdin where the person would paste them, just
# above the "End of your rules" line, in a copy of the policy, and checks
# that copy. After a line "--- tests ---", stdin may carry test cases for
# the rules: they're added to a copy of the policy's tests, which then run
# against the copy of the policy, so a new rule and its tests are known to
# pass before anything is pasted. Entries written at the left margin are
# indented to fit. Neither the policy nor its tests is changed.
if [ "$mode" = try ]; then
  end="  # ---- End of your rules ----"
  grep -qxF "$end" "$policy" ||
    fail "$policy has no '# ---- End of your rules ----' line (policies written before v0.7.0 don't). Put the rule above the first rule it should come before, then run check"
  mkdir -p "$data" || fail "can't create $data"
  scratch="$(mktemp -d "$data/try.XXXXXX")" || fail "can't create a folder in $data"
  trap 'rm -rf "$scratch"' EXIT
  cat >"$scratch/input"
  awk '/^--- tests ---[[:space:]]*$/ { exit } { print }' "$scratch/input" >"$scratch/rules"
  awk 'found { print } /^--- tests ---[[:space:]]*$/ { found = 1 }' "$scratch/input" >"$scratch/cases"
  # indent FILE: entries written at the left margin are indented two spaces.
  indent() {
    case "$(sed -n '/[^[:space:]]/{p;q;}' "$1")" in
      -*) sed -i.bak 's/^/  /' "$1" && rm -f "$1.bak" ;;
    esac
  }
  grep -q '[^[:space:]]' "$scratch/rules" || fail "give the rules to try on stdin"
  indent "$scratch/rules"
  awk -v end="$end" -v f="$scratch/rules" '$0 == end { while ((getline line < f) > 0) print line } { print }' \
    "$policy" >"$scratch/policy.yaml"
  echo "Your policy with these rules added, as it would be checked:"
  "$bin" -hook claude-code -check -config "$scratch/policy.yaml" || exit 1

  tests="${policy%.*}.test.yaml"
  if grep -q '[^[:space:]]' "$scratch/cases"; then
    [ -f "$tests" ] || fail "there are no tests at $tests to add these to"
    indent "$scratch/cases"
    { sed 's|^config:.*|config: policy.yaml|' "$tests" && echo && cat "$scratch/cases"; } >"$scratch/policy.test.yaml"
    echo
    echo "Your policy's tests, with these added, against that policy:"
    "$bin" -test "$scratch/policy.test.yaml"
    exit $?
  fi
  if [ -f "$tests" ] && grep -q '^require_every_rule: *true' "$tests"; then
    echo
    echo "No tests were given. Your tests require one for every rule, so add a test case for each new rule after a line '--- tests ---', and try again."
    exit 1
  fi
  exit 0
fi

# Not installed yet: start installing in the background, if nothing is, and
# say so. A tool call is blocked straight away rather than waiting.
if [ ! -x "$bin" ]; then
  release
  last=""
  if ! installing; then
    [ -s "$errors" ] && last=" The last try failed: $(cat "$errors")"
    background
  fi
  if [ "$mode" = setup ]; then
    tell "ConsequenceOS is downloading consequenced $VERSION (about 6 MB) in the background. Until it's done, it blocks Claude's tool calls; on a slow connection that can take a few minutes.$last"
    exit 0
  fi
  fail "it's still installing consequenced $VERSION in the background$(progress), and blocks every call until that's done. Try again in a minute.$last"
fi

# Installed. The starter policy, the first time, if the install didn't
# write it (consequenced came from CONSEQUENCEOS_BIN, or the policy was
# deleted).
write_policy

if [ "$mode" = setup ]; then
  if note="$(take_welcome)"; then tell "$note"; fi
  exit 0
fi

# The note about the starter policy goes with this call's answer, once.
if note="$(take_welcome)"; then
  answer="$("$bin" -hook claude-code -config "$policy")"
  code=$?
  if [ "$code" != 0 ]; then
    printf '%s' "$note" >"$welcome" # not shown; the next call tries again
    [ -n "$answer" ] && printf '%s\n' "$answer"
    exit "$code"
  fi
  if [ -z "$answer" ]; then
    tell "$note"
  else
    # consequenced answers with one JSON object; the note joins it.
    printf '{"systemMessage":%s,%s\n' "$(json "$note")" "${answer#\{}"
  fi
  exit 0
fi
exec "$bin" -hook claude-code -config "$policy"
